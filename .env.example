# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DISCORD_TOKEN: Token do seu Bot no Discord Developer Portal (Bot -> Reset Token).
# Configure este valor no painel Secrets do AI Studio para deixar o TEKOli ONLINE no Discord.
DISCORD_TOKEN="MY_DISCORD_BOT_TOKEN"

# DISCORD_CLIENT_ID: Application ID / Client ID do bot no Discord Developer Portal (opcional).
DISCORD_CLIENT_ID="MY_DISCORD_CLIENT_ID"

# DISCORD_PUBLIC_KEY: Public Key no Discord Developer Portal -> General Information (opcional, para /api/discord/interactions).
DISCORD_PUBLIC_KEY="MY_DISCORD_PUBLIC_KEY"

# MONGODB_URI: Connection string do MongoDB Atlas (opcional - usa os 88 ratholes em memoria se vazio).
MONGODB_URI="MY_MONGODB_URI"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
